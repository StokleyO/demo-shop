{
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/signup",
      "destination": "/signup.html"
    },
    {
      "source": "/welcome",
      "destination": "/welcome.html"
    },
    {
      "source": "/cart",
      "destination": "/cart.html"
    },
    {
      "source": "/checkout/address",
      "destination": "/address.html"
    },
    {
      "source": "/checkout/payment",
      "destination": "/payment.html"
    },
    {
      "source": "/order/confirmation",
      "destination": "/confirmation.html"
    },
    {
      "source": "/product/:id",
      "destination": "/product.html"
    }
  ]
}
